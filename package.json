{
  "name": "jg-teacher-park-hwan-hee",
  "version": "1.2.0",
  "private": true,
  "description": "LCU와 Live Client Data를 사용하는 정글 동선 코치 오버레이",
  "author": "jgTeacherParkHwanHee",
  "license": "MIT",
  "main": "ui/main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node scripts/start.cjs",
    "demo": "node scripts/start.cjs --demo",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.cjs",
    "smoke": "node scripts/smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": { "league-connect": "6.0.0-rc13" },
  "devDependencies": { "electron": "45.5.0", "electron-builder": "26.18.0" },
  "build": {
    "appId": "com.jgteacher.parkhwanhee",
    "productName": "Jungle Teacher",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["ui/**/*", "service/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" }
  }
}
